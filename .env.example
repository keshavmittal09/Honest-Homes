# Honest Homes — environment config TEMPLATE.
# Copy this file to ".env" and fill in real values:   cp .env.example .env
# In production, set these in the Render dashboard (Environment tab) instead.

# --- Public contact info (shown in the "Request a project" form) ---
# Safe to expose to the browser via /api/config.
HH_CONTACT_EMAIL=you@example.com
HH_CONTACT_FORM_ENDPOINT=          # optional, e.g. https://formspree.io/f/xxxxxxx
HH_CONTACT_WHATSAPP=               # optional, digits only, e.g. 9199XXXXXXXX

# --- Supabase (durable storage for user submissions) — server-only secrets ---
# Where visitor submissions (leads/requests/inquiries) are stored. Run
# supabase_submissions.sql first, then set the SERVICE ROLE key below
# (Supabase dashboard -> Project Settings -> API -> service_role secret).
# NEVER expose SUPABASE_KEY to the browser or commit it.
SUPABASE_URL=https://buhxytlquxsxziagooog.supabase.co
SUPABASE_KEY=          # service_role secret key

# --- Instant lead notifications — server-only secrets ---
# Every channel is independent and stays silent until BOTH of its keys are set,
# so you can run one, two or all three. A channel that fails is logged and
# swallowed: a dead notifier must never cost us the lead itself.
#
# Easiest path is the setup helper, which verifies each credential before saving
# and writes into .env in place:
#     python -m api.notify_setup chatid --token <BOTFATHER_TOKEN> --write
#     python -m api.notify_setup email  --user you@gmail.com --pass "<APP_PASSWORD>" --write
#     python -m api.notify_setup status
#     python -m api.notify_setup test

# Email via Gmail SMTP. HH_SMTP_PASS must be a 16-character App Password
# (Google Account -> Security -> 2-Step Verification -> App passwords), NOT your
# login password; Google blocks plain-password SMTP outright.
HH_SMTP_USER=          # e.g. you@gmail.com
HH_SMTP_PASS=          # 16-char App Password
HH_NOTIFY_EMAIL=       # optional, where alerts land (defaults to HH_SMTP_USER)

# Telegram — the fastest and most reliable of the three, and entirely free.
# Create a bot in @BotFather, send it any message, then run the chatid helper:
# Telegram will not reveal a chat id until the chat exists.
HH_TELEGRAM_TOKEN=     # from @BotFather, e.g. 1234567890:AA...
HH_TELEGRAM_CHAT=      # your numeric chat id

# WhatsApp via CallMeBot — free but a rate-limited third party, so treat it as a
# nice-to-have rather than the channel you rely on. See callmebot.com/apps/
HH_CALLMEBOT_PHONE=    # with country code, digits only, e.g. 9198XXXXXXXX
HH_CALLMEBOT_KEY=      # api key from CallMeBot's activation reply
