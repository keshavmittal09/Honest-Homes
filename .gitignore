# Env (local only; production uses Render dashboard vars). .env.example IS committed.
.env

# Captured visitor leads — never commit personal data
data/leads.jsonl

# Tier-2 detail captures — NONE of it is committed.
# Documents are served from Supabase Storage (URLs live in detail_parsed/*/records.json);
# at 12,000+ files / 5+ GB they are far past what git or a Render clone should carry.
data/snapshots/detail/


# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Snapshots - collect fresh data monthly
data/snapshots/*/recon/
data/snapshots/*/checkpoint.json
data/snapshots/index/2026-06-01/
data/snapshots/index/2026-06-02/snapshot.json
data/snapshots/reputation/2026-06-04/snapshot.json

# But commit the JSONL files needed for deployment
!data/snapshots/index/2026-06-02/rows.jsonl
!data/snapshots/reputation/2026-06-04/complaints.jsonl
!data/snapshots/reputation/2026-06-04/revoked.jsonl

# Loose copies at snapshots/<kind>/ duplicate the dated snapshot dirs and are
# never read (the loaders glob for dated subdirectories). Keep only the dated ones.
data/snapshots/index/*.jsonl
data/snapshots/index/*.json
data/snapshots/reputation/*.jsonl
data/snapshots/reputation/*.json

# --- Region packages -------------------------------------------------------
# The per-project document files are hard links into data/snapshots/detail/,
# which is already ignored: ~10 GB of PDFs against ~1 GB of Supabase storage.
# The site shows document NAMES from records.json and links out to MahaRERA for
# the files themselves, so nothing here is needed to render a page.
data/regions/*/projects/*/documents/
data/regions/*/projects/*/complaints/*/documents/

# The full neighbourhood record keeps 40 places per category for analysis
# (~110 KB each). `amenities-lite.json` is the shipped form and IS committed.
data/regions/*/projects/*/amenities/amenities.json

# Stitched map tiles are cached here so neighbouring projects reuse them; the
# finished map-street/map-satellite images are committed, this scratch is not.
data/regions/_tilecache/
